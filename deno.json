{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-read --allow-write --allow-env main.ts",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env main.ts",
    "test": "deno test --allow-net --allow-read --allow-write --allow-env tests/",
    "check": "deno check main.ts",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "imports": {
    "@std/http": "jsr:@std/http@^1.1.2",
    "@std/http/cookie": "jsr:@std/http@^1.1.2/cookie",
    "@std/http/file-server": "jsr:@std/http@^1.1.2/file-server",
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "zod": "npm:zod@^3.23.8"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window"]
  },
  "fmt": {
    "singleQuote": false,
    "lineWidth": 100
  },
  "exclude": ["data/*.jsonl"]
}
